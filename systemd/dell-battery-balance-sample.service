[Unit]
Description=Sample Dell dual-battery state for wear tracking
Documentation=file:/usr/local/share/doc/dell-battery-balance/README.md
ConditionPathExists=/sys/class/power_supply/BAT1

[Service]
Type=oneshot
ExecStart=/usr/local/bin/dell-battery-balance sample
Nice=10
IOSchedulingClass=idle
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/var/lib/dell-battery-balance
